{
  "name": "byte-wiki-vscode",
  "displayName": "Byte-Wiki",
  "description": "在 VSCode 中查看 byte-wiki 的仓库 Wiki 与函数调用链；插入/捕获片段与模板",
  "version": "0.0.1",
  "publisher": "byte-wiki",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cicbyte/byte-wiki.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Snippets", "Other"],
  "icon": "icon.png",
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "byte-wiki",
          "title": "Byte Wiki",
          "icon": "media/book.svg"
        }
      ]
    },
    "views": {
      "byte-wiki": [
        {
          "id": "byteWiki.pages",
          "name": "Wiki 页面"
        },
        {
          "id": "byteWiki.callchain",
          "name": "调用链入口"
        }
      ]
    },
    "commands": [
      { "command": "byteWiki.insertAny", "title": "插入片段或模板", "category": "Byte-Wiki" },
      { "command": "byteWiki.insertSnippet", "title": "插入片段", "category": "Byte-Wiki" },
      { "command": "byteWiki.insertTemplate", "title": "插入模板", "category": "Byte-Wiki" },
      { "command": "byteWiki.captureSelectionSnippet", "title": "存选中为片段", "category": "Byte-Wiki" },
      { "command": "byteWiki.captureSelectionTemplate", "title": "存选中为模板", "category": "Byte-Wiki" },
      { "command": "byteWiki.captureFileSnippet", "title": "存文件为片段", "category": "Byte-Wiki" },
      { "command": "byteWiki.captureFileTemplate", "title": "存文件为模板", "category": "Byte-Wiki" },
      { "command": "byteWiki.importFolder", "title": "导入为项目", "category": "Byte-Wiki" },
      { "command": "byteWiki.openPage", "title": "打开 Wiki 页面", "category": "Byte-Wiki", "icon": "$(preview)" },
      { "command": "byteWiki.refreshPages", "title": "刷新 Wiki 页面", "category": "Byte-Wiki", "icon": "$(refresh)" },
      { "command": "byteWiki.refreshCallchain", "title": "刷新调用链", "category": "Byte-Wiki", "icon": "$(refresh)" },
      { "command": "byteWiki.generateCallchain", "title": "生成调用链（bw callchain）", "category": "Byte-Wiki", "icon": "$(play)" },
      { "command": "byteWiki.openChain", "title": "走读链（DFS 先序）", "category": "Byte-Wiki", "icon": "$(list-tree)" },
      { "command": "byteWiki.openFunction", "title": "打开函数源码", "category": "Byte-Wiki", "icon": "$(go-to-file)" },
      { "command": "byteWiki.searchNode", "title": "搜索调用链节点", "category": "Byte-Wiki", "icon": "$(search)" },
      { "command": "byteWiki.setBsPath", "title": "设置 bw CLI 路径", "category": "Byte-Wiki", "icon": "$(settings-gear)" },
      { "command": "byteWiki.showGraph", "title": "调用链图", "category": "Byte-Wiki", "icon": "$(graph)" }
    ],
    "submenus": [
      { "id": "byteWiki.context", "label": "Byte-Wiki" },
      { "id": "byteWiki.explorer", "label": "Byte-Wiki" }
    ],
    "configuration": {
      "title": "Byte-Wiki",
      "properties": {
        "byteWiki.mode": {
          "type": "string",
          "enum": ["auto", "cli", "http"],
          "default": "auto",
          "enumDescriptions": [
            "自动：检测到 bw CLI 就用 CLI（零桌面端依赖），否则用 HTTP",
            "强制 CLI：通过 bw 进程访问本地库（需 bw 在 PATH 或配置 cliPath）",
            "强制 HTTP：通过桌面端 REST API（需开启 REST 服务）"
          ],
          "markdownDescription": "数据访问方式（片段/模板功能）。`auto`（默认）= 检测到 bw CLI 就走 CLI（免开桌面端），否则回退 HTTP。Wiki/调用链视图直读 `.bytewiki/` 产物 + `bw callchain-query`，不走此开关。"
        },
        "byteWiki.cliPath": {
          "type": "string",
          "default": "bw",
          "markdownDescription": "`bw` CLI 可执行文件路径或命令名（默认 `bw`，假设在 PATH；byte-wiki 的 CLI 名是 bw，区别于 byte-stash 的 bs）。CLI/auto 模式与调用链查询共用。"
        },
        "byteWiki.baseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "byte-wiki REST API 地址，如 `http://localhost:3987/api/v1`。在桌面端「设置 → REST API」开启后复制。"
        },
        "byteWiki.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "REST API Key（桌面端「设置 → REST API」生成）。⚠️ 即便本地访问也需填写（当前后端 `allow_local_no_key` 未生效）。"
        },
        "byteWiki.enableTriggers": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "是否在编辑器中启用片段/模板的 trigger 智能补全。"
        },
        "byteWiki.matchLanguage": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "补全是否按当前文档语言过滤候选。关闭则纯按 trigger/标题名称匹配（所有语言都作为候选，适合 markdown / 笔记等跨语言场景）。"
        }
      }
    },
    "menus": {
      "view/title": [
        { "command": "byteWiki.refreshPages", "when": "view == byteWiki.pages", "group": "navigation" },
        { "command": "byteWiki.showGraph", "when": "view == byteWiki.callchain", "group": "navigation" },
        { "command": "byteWiki.generateCallchain", "when": "view == byteWiki.callchain", "group": "navigation" },
        { "command": "byteWiki.searchNode", "when": "view == byteWiki.callchain", "group": "navigation" },
        { "command": "byteWiki.setBsPath", "when": "view == byteWiki.callchain", "group": "navigation" },
        { "command": "byteWiki.refreshCallchain", "when": "view == byteWiki.callchain", "group": "navigation" }
      ],
      "view/item/context": [
        { "command": "byteWiki.openChain", "when": "view == byteWiki.callchain && viewItem == entry", "group": "inline" },
        { "command": "byteWiki.showGraph", "when": "view == byteWiki.callchain && viewItem == entry", "group": "inline@2" },
        { "command": "byteWiki.openFunction", "when": "view == byteWiki.callchain && viewItem == entry", "group": "inline@3" }
      ],
      "editor/context": [
        { "submenu": "byteWiki.context", "group": "byteWiki@1", "when": "editorTextFocus" }
      ],
      "byteWiki.context": [
        { "command": "byteWiki.insertAny", "group": "01_insert@1", "when": "editorTextFocus" },
        { "command": "byteWiki.insertSnippet", "group": "01_insert@2", "when": "editorTextFocus" },
        { "command": "byteWiki.insertTemplate", "group": "01_insert@3", "when": "editorTextFocus" },
        { "command": "byteWiki.captureSelectionSnippet", "group": "02_capture@1", "when": "editorHasSelection" },
        { "command": "byteWiki.captureSelectionTemplate", "group": "02_capture@2", "when": "editorHasSelection" },
        { "command": "byteWiki.importFolder", "group": "03_import@1", "when": "workbenchState" }
      ],
      "explorer/context": [
        { "submenu": "byteWiki.explorer", "group": "byteWiki@1" }
      ],
      "byteWiki.explorer": [
        { "command": "byteWiki.captureFileSnippet", "group": "01_capture@1", "when": "!explorerResourceIsFolder && resourceExtname != '.png' && resourceExtname != '.jpg' && resourceExtname != '.jpeg' && resourceExtname != '.gif' && resourceExtname != '.webp' && resourceExtname != '.bmp' && resourceExtname != '.ico' && resourceExtname != '.tiff' && resourceExtname != '.exe' && resourceExtname != '.dll' && resourceExtname != '.so' && resourceExtname != '.zip' && resourceExtname != '.gz' && resourceExtname != '.7z' && resourceExtname != '.rar' && resourceExtname != '.pdf' && resourceExtname != '.mp3' && resourceExtname != '.mp4' && resourceExtname != '.avi' && resourceExtname != '.mov' && resourceExtname != '.mkv'" },
        { "command": "byteWiki.captureFileTemplate", "group": "01_capture@2", "when": "!explorerResourceIsFolder && resourceExtname != '.png' && resourceExtname != '.jpg' && resourceExtname != '.jpeg' && resourceExtname != '.gif' && resourceExtname != '.webp' && resourceExtname != '.bmp' && resourceExtname != '.ico' && resourceExtname != '.tiff' && resourceExtname != '.exe' && resourceExtname != '.dll' && resourceExtname != '.so' && resourceExtname != '.zip' && resourceExtname != '.gz' && resourceExtname != '.7z' && resourceExtname != '.rar' && resourceExtname != '.pdf' && resourceExtname != '.mp3' && resourceExtname != '.mp4' && resourceExtname != '.avi' && resourceExtname != '.mov' && resourceExtname != '.mkv'" },
        { "command": "byteWiki.importFolder", "group": "02_import@1", "when": "explorerResourceIsFolder" }
      ],
      "commandPalette": [
        { "command": "byteWiki.insertAny" },
        { "command": "byteWiki.insertSnippet" },
        { "command": "byteWiki.insertTemplate" },
        { "command": "byteWiki.captureSelectionSnippet", "when": "editorHasSelection" },
        { "command": "byteWiki.captureSelectionTemplate", "when": "editorHasSelection" },
        { "command": "byteWiki.captureFileSnippet" },
        { "command": "byteWiki.captureFileTemplate" },
        { "command": "byteWiki.importFolder" },
        { "command": "byteWiki.refreshPages" },
        { "command": "byteWiki.refreshCallchain" },
        { "command": "byteWiki.generateCallchain" },
        { "command": "byteWiki.searchNode" },
        { "command": "byteWiki.setBsPath" }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js --production",
    "dev": "node esbuild.js --watch",
    "package": "vsce package",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.30.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.4.0"
  }
}
